{
  "name": "scala-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Scala Workspaces Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspace=apps/admin",
    "start": "npm run start --workspace=apps/admin",
    "lint": "npm run lint --workspace=apps/admin"
  }
}
