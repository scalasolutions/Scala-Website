{
  "name": "scala-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Scala Workspaces Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "start": "npm run start --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "db:seed": "npm run db:seed --workspace=apps/web",
    "db:backup": "npm run db:backup --workspace=apps/web",
    "db:restore": "npm run db:restore --workspace=apps/web"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
